# Copy to .env for local scripts and tooling. Never commit .env.
# The live bot keeps its secrets in n8n Credentials, not here.

# n8n API / MCP access (from your n8n instance settings)
N8N_BASE_URL=https://your-n8n-host.example.com
N8N_API_KEY=replace-me

# Optional: direct DB access for local debugging (read-only user recommended)
DATABASE_URL=postgresql://readonly_user:replace-me@localhost:5432/darribni
