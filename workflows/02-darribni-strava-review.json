    {
      "parameters": {
        "jsCode": "const context = $input.first().json;\nconst activity = $('Get an activity').item.json;\n\nconst prompt = `You are an elite endurance coach.\nYour athlete just completed a new activity on Strava.\n\n### ACTIVITY DETAILS\nSport: ${activity.type}\nDistance: ${(activity.distance / 1000).toFixed(2)} km\nTime: ${Math.round(activity.moving_time / 60)} mins\nAvg HR: ${activity.average_heartrate || 'N/A'} bpm\n\n### WHAT WAS PLANNED FOR TODAY\n${JSON.stringify(context.planned_today || \"Nothing planned for today.\")}\n\n### COACH NOTES\n${context.coach_notes}\n\n### INSTRUCTIONS\nAnalyze this activity. Did they follow the plan? Did they go too hard? \nWrite a short, encouraging message to the athlete directly (2-3 sentences max).`;\n\nreturn {\n    systemPrompt: prompt,\n    telegramId: context.telegram_id\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2288,
        432
      ],
      "id": "8d185edd-b223-4a12-949a-d7817d017d66",
      "name": "Code Prepare Analysis Prompt"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH athlete_data AS (\n    SELECT id, coach_notes, telegram_id FROM athletes WHERE strava_id = '{{ $('Strava Trigger').item.json.owner_id }}' LIMIT 1\n),\ntoday_plan AS (\n    SELECT sport_type, description, target_duration_mins \n    FROM workouts \n    WHERE athlete_id = (SELECT id FROM athlete_data) AND scheduled_date = CURRENT_DATE\n)\nSELECT \n    (SELECT json_agg(row_to_json(tp.*)) FROM today_plan tp) as planned_today,\n    coach_notes,\n    telegram_id\nFROM athlete_data;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
