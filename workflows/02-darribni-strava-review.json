      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activities (strava_activity_id, athlete_id, start_date, sport_type, summary_metrics)\nVALUES (\n  '{{ $json.id }}',\n  (SELECT id FROM athletes WHERE strava_id = '{{ $json.athlete.id }}' LIMIT 1),\n  '{{ $json.start_date }}',\n  '{{ $json.type }}',\n  jsonb_build_object(\n    'distance_m', {{ $json.distance }},\n    'time_s',     {{ $json.moving_time }},\n    'avg_hr',     {{ $json.average_heartrate ?? 'null' }}\n  )\n)\nON CONFLICT (strava_activity_id) DO UPDATE SET summary_metrics = EXCLUDED.summary_metrics\nRETURNING id;",
        "options": {}
      },
