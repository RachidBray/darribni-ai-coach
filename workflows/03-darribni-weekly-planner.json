{
  "name": "Darribni - Weekly Planner",
  "nodes": [
    {
      "id": "4c7e2796-d39b-45b6-b94a-80d160d63fb7",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        560,
        816
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtHour": 18
            }
          ]
        }
      }
    },
    {
      "id": "1cd0c29b-b12f-479b-9dff-c1a166fddb76",
      "name": "Postgres Node (Fetch Athletes)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        768,
        816
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM athletes;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "c30e7d2f-4f80-462f-bcda-549a9267174e",
      "name": "Postgres Fetch Weekly",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1000,
        816
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=WITH week_activities AS (\n    SELECT sport_type, SUM(CAST(summary_metrics->>'distance_m' AS NUMERIC)) as total_dist, SUM(CAST(summary_metrics->>'time_s' AS NUMERIC)) as total_time\n    FROM activities\n    WHERE athlete_id = '{{ $json.id }}' AND start_date > NOW() - INTERVAL '7 days'\n    GROUP BY sport_type\n),\nupcoming AS (\n    SELECT scheduled_date, sport_type, title, description, target_duration_mins\n    FROM workouts\n    WHERE athlete_id = '{{ $json.id }}' AND scheduled_date > CURRENT_DATE AND scheduled_date <= CURRENT_DATE + 7\n    ORDER BY scheduled_date\n)\nSELECT\n    (SELECT json_agg(row_to_json(wa.*)) FROM week_activities wa) as week_volume,\n    (SELECT json_agg(row_to_json(u.*)) FROM upcoming u) as upcoming_workouts,\n    coach_notes,\n    telegram_id\nFROM athletes WHERE id = '{{ $json.id }}';",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "56698ae3-67b0-40fb-bc28-d3b703cf6912",
      "name": "Code Prepare Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        816
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $json;\nconst prompt = `You are an elite endurance coach. It is Sunday evening. Today's date: ${new Date().toISOString().split('T')[0]}.\n\n### ATHLETE CONTEXT\nCoach Notes: ${c.coach_notes || 'None'}\n\n### PAST WEEK VOLUME (from Strava)\n${JSON.stringify(c.week_volume || 'No activities recorded.')}\n\n### NEXT 7 DAYS (from the athlete's own training plan, DO NOT change it)\n${JSON.stringify(c.upcoming_workouts || 'No sessions planned.')}\n\n### INSTRUCTIONS\n1. Write a short weekly recap (under 150 words): one or two lines on last week's volume, then the key sessions of the coming week day by day, and one focus tip.\n2. Do NOT invent, add, remove or modify workouts. The plan is fixed.\n3. Do NOT output any JSON.`;\nreturn { json: { systemPrompt: prompt, telegramId: c.telegram_id } };"
      }
    },
    {
      "id": "6526f752-46fc-43a7-8f2e-240a4526e52d",
      "name": "Basic LLM Chain (Call AI)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1440,
        816
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Write my weekly recap for the week starting {{ $today.plus({ days: 1 }).toISODate() }}.",
        "messages": {
          "messageValues": [
            {
              "message": "={{ $json.systemPrompt }}"
            }
          ]
        },
        "batching": {}
      }
    },
    {
      "id": "5804597d-f425-4cc9-a79b-2ee6c9807b86",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        1440,
        1020
      ],
      "parameters": {
        "model": "anthropic/claude-opus-4.6",
        "options": {}
      },
      "credentials": {
        "openRouterApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "id": "6e3ee6f4-5258-48c6-bb54-70339982c867",
      "name": "Telegram (Send Summary)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1700,
        816
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Code Prepare Prompt').item.json.telegramId }}",
        "text": "={{ $json.text.substring(0, 4000) }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    }
  ],
